{
  "timeoutMs": 180000,
  "packages": {
    "pi-browser": {
      "source": {
        "type": "git",
        "url": "https://github.com/kvidzibo/pi-browser.git",
        "branch": "main"
      },
      "managed": {
        "build": [{ "command": "npm", "args": ["ci", "--ignore-scripts"] }, { "command": "npm", "args": ["run", "build:mcp"] }],
        "validate": [{ "command": "npm", "args": ["run", "typecheck"] }, { "command": "npm", "args": ["run", "test:mcp"] }],
        "timeoutMs": 300000
      }
    }
  },
  "mcpServers": {
    "browser": {
      "package": "pi-browser",
      "command": "node",
      "args": ["{{packageRoot}}/mcp/cli.mjs"],
      "cwd": "{{packageRoot}}"
    }
  }
}
