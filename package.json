{
  "name": "local-stdio-mcp-gateway",
  "version": "0.28.1",
  "private": true,
  "description": "A small stdio MCP gateway with per-run service identity",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "local-mcp-gateway": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.examples-build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./pi/gateway.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typebox": "^1.3.36",
    "typescript": "^5.9.3"
  }
}
